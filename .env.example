# AutoPatch AI Environment Configuration
# ==============================================================================
# 1. Google Gemini API (100% Free Tier Eligible)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended model for high-fidelity code patching (fast, deterministic, free tier)
GEMINI_MODEL=gemini-2.5-flash

# 2. GitHub Personal Access Token (Free)
# Generate from: https://github.com/settings/tokens
# Required Scopes:
#   - 'public_repo' (for public open-source repos) OR 'repo' (for private repos)
#   - 'workflow' (optional, if touching workflow files)
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# 3. Docker Sandbox Configuration (Local Docker Daemon)
# macOS / Linux default socket:
DOCKER_HOST=unix:///var/run/docker.sock
# Windows Docker Desktop WSL2 socket alternative:
# DOCKER_HOST=npipe:////./pipe/docker_engine

# Default execution timeout in seconds for running repository tests inside Docker
SANDBOX_TIMEOUT_SECONDS=180

# Ephemeral base image to use for python testing sandboxes
DOCKER_SANDBOX_IMAGE=python:3.11-slim

# 4. Agent Safety & Pipeline Defaults
# Default test command to execute inside sandbox before PR creation
DEFAULT_TEST_COMMAND=pytest -v

# Max patch repair attempts if test suite fails
MAX_PATCH_RETRIES=2
